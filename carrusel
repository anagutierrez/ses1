<script>
    // Countdown Logic
    const targetDate = new Date('August 18, 2026 08:00:00').getTime();

    function updateCountdown() {
        const now = new Date().getTime();
        const difference = targetDate - now;

        if (difference < 0) return;

        const d = Math.floor(difference / (1000 * 60 * 60 * 24));
        const h = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((difference % (1000 * 60)) / 1000);

        document.getElementById('days').innerText = d.toString().padStart(2, '0');
        document.getElementById('hours').innerText = h.toString().padStart(2, '0');
        document.getElementById('minutes').innerText = m.toString().padStart(2, '0');
        document.getElementById('seconds').innerText = s.toString().padStart(2, '0');
    }

    setInterval(updateCountdown, 1000);
    updateCountdown();

    // Mobile Menu Toggle Logic
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if(menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            mobileMenu.classList.toggle('hidden');
            const icon = menuBtn.querySelector('.material-symbols-outlined');
            icon.innerText = mobileMenu.classList.contains('hidden') ? 'menu' : 'close';
        });

        // Close menu on click outside
        document.addEventListener('click', (e) => {
            if (!mobileMenu.contains(e.target) && !menuBtn.contains(e.target)) {
                mobileMenu.classList.add('hidden');
                menuBtn.querySelector('.material-symbols-outlined').innerText = 'menu';
            }
        });

        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                menuBtn.querySelector('.material-symbols-outlined').innerText = 'menu';
            });
        });
    }

    // Schedule Tabs Logic
    const tabButtons = document.querySelectorAll('#schedule-tabs button');
    const dayContents = document.querySelectorAll('.schedule-day');

    tabButtons.forEach(button => {
        button.addEventListener('click', () => {
            const targetDay = button.getAttribute('data-day');

            tabButtons.forEach(btn => {
                btn.classList.remove('bg-primary', 'text-white', 'shadow-md');
                btn.classList.add('text-gray-500', 'hover:bg-gray-200');
            });
            button.classList.add('bg-primary', 'text-white', 'shadow-md');
            button.classList.remove('text-gray-500', 'hover:bg-gray-200');

            dayContents.forEach(content => {
                if (content.id === `day-${targetDay}`) {
                    content.classList.remove('hidden');
                    content.classList.add('block', 'animate-fade-in');
                } else {
                    content.classList.add('hidden');
                    content.classList.remove('block', 'animate-fade-in');
                }
            });
        });
    });

    // Carousel Logic - Updated for auto-play and animated indicators
    const track = document.getElementById('carousel-track');
    const slides = Array.from(track.children);
    const nextButton = document.getElementById('next-slide');
    const prevButton = document.getElementById('prev-slide');
    const dotsNav = document.getElementById('carousel-indicators');
    const dots = Array.from(dotsNav.children);

    let currentIndex = 0;
    let autoplayInterval;
    const slideDuration = 6000;

    const updateSlidePosition = () => {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
        slides.forEach((slide, index) => {
            if(index === currentIndex) {
                slide.classList.add('active');
            } else {
                slide.classList.remove('active');
            }
        });
    };

    const updateDots = () => {
        dots.forEach((dot, index) => {
            if (index === currentIndex) {
                dot.classList.add('active');
                // Reset progress animation
                const progress = dot.querySelector('.indicator-progress');
                progress.style.transition = 'none';
                progress.style.width = '0%';
                setTimeout(() => {
                    progress.style.transition = `width ${slideDuration}ms linear`;
                    progress.style.width = '100%';
                }, 50);
            } else {
                dot.classList.remove('active');
                dot.querySelector('.indicator-progress').style.width = '0%';
            }
        });
    };

    const moveToNextSlide = () => {
        currentIndex = (currentIndex + 1) % slides.length;
        updateSlidePosition();
        updateDots();
        resetAutoplay();
    };

    const moveToPrevSlide = () => {
        currentIndex = (currentIndex - 1 + slides.length) % slides.length;
        updateSlidePosition();
        updateDots();
        resetAutoplay();
    };

    const startAutoplay = () => {
        autoplayInterval = setInterval(moveToNextSlide, slideDuration);
        updateDots(); // Start initial progress bar
    };

    const resetAutoplay = () => {
        clearInterval(autoplayInterval);
        startAutoplay();
    };

    nextButton.addEventListener('click', moveToNextSlide);
    prevButton.addEventListener('click', moveToPrevSlide);

    dotsNav.addEventListener('click', e => {
        const targetDot = e.target.closest('.indicator');
        if (!targetDot) return;
        
        currentIndex = parseInt(targetDot.dataset.index);
        updateSlidePosition();
        updateDots();
        resetAutoplay();
    });

    // Initialize carousel
    updateSlidePosition();
    startAutoplay();

</script>
<script>
(function() {
    const carousel = document.getElementById('hero-carousel');
    const pauseBtn = document.getElementById('carousel-pause-toggle');
    const pauseIcon = pauseBtn.querySelector('.material-symbols-outlined');
    let isPaused = false;

    function togglePause() {
        isPaused = !isPaused;
        if (isPaused) {
            clearInterval(autoplayInterval);
            pauseIcon.innerText = 'play_arrow';
            // Pause CSS animations for progress bars
            document.querySelectorAll('.indicator-progress').forEach(p => p.style.animationPlayState = 'paused');
        } else {
            startAutoplay();
            pauseIcon.innerText = 'pause';
            document.querySelectorAll('.indicator-progress').forEach(p => p.style.animationPlayState = 'running');
        }
    }

    pauseBtn.addEventListener('click', togglePause);

    carousel.addEventListener('mouseenter', () => {
        if (!isPaused) {
            clearInterval(autoplayInterval);
            document.querySelectorAll('.indicator-progress').forEach(p => p.style.animationPlayState = 'paused');
        }
    });

    carousel.addEventListener('mouseleave', () => {
        if (!isPaused) {
            resetAutoplay();
            document.querySelectorAll('.indicator-progress').forEach(p => p.style.animationPlayState = 'running');
        }
    });

    // Override the existing updateDots to handle the paused state
    const originalUpdateDots = window.updateDots;
    window.updateDots = function() {
        if (typeof originalUpdateDots === 'function') originalUpdateDots();
        if (isPaused) {
            document.querySelectorAll('.indicator-progress').forEach(p => p.style.animationPlayState = 'paused');
        }
    };
})();
</script>
